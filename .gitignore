# ---- Visual Studio / Rider ----
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
mono_crash.*

# IDE 캐시
.vs/

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# 잡다한 빌드 산출물
*.tmp
*.tmp_proj
*.log
*.pidb
*.pdb
.builds

# ---- Unity ----
# Unity가 재생성하는 폴더. Temp/는 에디터 실행 중 잠겨 있어
# 스테이징하려 하면 "Permission denied"로 커밋이 죽는다.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 에디터·IDE 산출물
.vsconfig
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
.idea/
ExportedObj/
*.unitypackage
crashlytics-build.properties
sysinfo.txt

# Unity가 매번 다시 만드는 프로젝트 파일
*.csproj
*.unityproj
*.sln
*.svd
*.booproj
*.pdb.meta
*.mdb.meta

# Unity에서 .meta는 에셋 GUID를 담고 있어 반드시 커밋해야 한다.
!*.meta

# ---- 대용량 게임 리소스 ----
# 원본에서 추출한 에셋과 그 가공물. 오디오·이미지가 대부분이라 git 이력에
# 넣으면 되돌릴 수 없게 무거워진다. 아래 에디터 도구로 외부 원본에서 복구한다.
#   Tools > Trickcal Revive > Main UI > Recover Content and Build All
#   Tools > Trickcal Revive > Flow    > Recover Content and Build Scenes
/[Aa]ssets/resources/
/[Aa]ssets/LocalGameContent/

# 외부 도구 바이너리·압축본. 프로젝트 소스가 아니다.
/[Aa]ssets/.local-tools/

# 스크린샷·임시 산출물
/TestArtifacts/

# ---- 작업 전용 폴더 ----
# AI 역할별 작업공간. 프로젝트 코드가 아니라 git에 올리지 않는다.
/AI팀/
