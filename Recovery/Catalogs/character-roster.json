  "sourcePolicy": {
    "primary": "Trickcal_Reference/03_extracted_resources/02_raw_data",
    "legacyProjectRole": "selection-and-validation-reference-only",
    "include": [
      "base portrait",
      "roster icon",
      "admission skill icon",
      "graduate skill icon",
      "base InGame Spine",
      "base Standing Spine for apostles",
      "Korean battle voice",
      "battle SFX"
    ],
    "exclude": [
      "skins",
      "aside resources",
      "Japanese voice",
      "story and lobby voice",
      "unconfirmed or synthetic replacements",
      "production scenes and gameplay logic"
    ]
  },
  "audioSelection": {
    "apostleBattleVoiceNameRegex": "(BasicAttack|Defeat|Die|Hit|PowerAttack|Shout|Spawn|SPSkill|Ultimate|Victory|SkillCast|SkillHit)",
    "excludedNameRegex": "(Aside|Skin)",
    "apostleSfx": "all .ogg files in the selected base hero directory except names containing Aside or Skin",
    "monsterAudio": "all .ogg files in the selected base monster SFX and Korean voice directories",
    "ordering": "ordinal file-name order"
  },
